generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(buyer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rfqs      Rfq[]
}

enum UserRole {
  buyer
  supplier
  admin
}


model Rfq {
  id         String   @id @default(cuid())
  title       String
  category   String
  quantity   Int
  budget     Float
  deadline   DateTime
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  //connect to user 
  userId     String
  user       User     @relation(fields: [userId], references: [id])

}